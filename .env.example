# Copy to .env and edit. .env is gitignored; .env.example is tracked.

# PostgreSQL connection string for conversation history.
# Local server with peer auth over a unix socket needs no password:
SEMESTER_DB_DSN=postgresql:///fall_semester_assistant

# Explicit host/port form, if you are not using a local socket:
# SEMESTER_DB_DSN=postgresql://user:password@localhost:5432/fall_semester_assistant
